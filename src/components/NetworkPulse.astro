---
import { ArrowRight } from '@lucide/astro';
import InfoCard from './InfoCard.astro';
---

<section class="relative px-4 py-16 bg-black border-t border-white/10 overflow-hidden">
  <div class="max-w-6xl mx-auto">
    {/* Section header */}
    <div class="flex items-end justify-between flex-wrap gap-4 mb-8">
      <div>
        <div class="inline-flex items-center gap-2 mb-3">
          <span
            data-live-status
            role="status"
            class="font-mono text-[13px] text-white/70 tracking-[0.02em]"
            >Loading observations…</span
          >
        </div>
        <h2 class="text-[clamp(28px,4vw,40px)] text-white tracking-tight leading-[1.1] mb-2">
          The mesh, right now.
        </h2>
        <p class="text-white/70 text-base leading-relaxed max-w-[480px]">
          Counts refresh every 5 minutes from the KC MeshMonitor instance.
        </p>
      </div>
      <a
        href="/status"
        class="inline-flex items-center gap-1.5 text-sm text-white/70 hover:text-white transition-colors"
      >
        Full network status
        <ArrowRight class="w-3.5 h-3.5" />
      </a>
    </div>

    {/* 3 stat tiles */}
    <div
      class="grid gap-3 mb-6"
      style="grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));"
    >
      <InfoCard>
        <div class="text-white/50 text-[11px] uppercase tracking-[0.08em] mb-2 font-medium">
          Active · 30 days
        </div>
        <div class="flex items-baseline gap-2.5">
          <span
            class="font-mono text-[48px] font-semibold leading-none tracking-[-0.03em] text-(--success-500)"
            data-live-stat="active_30d"
          >
            —
          </span>
          <span class="font-mono text-[13px] text-white/50">nodes</span>
        </div>
      </InfoCard>

      <InfoCard>
        <div class="text-white/50 text-[11px] uppercase tracking-[0.08em] mb-2 font-medium">
          Total registered
        </div>
        <div class="flex items-baseline gap-2.5">
          <span
            class="font-mono text-[48px] font-semibold leading-none tracking-[-0.03em] text-(--info-500)"
            data-live-stat="total_nodes"
          >
            —
          </span>
          <span class="font-mono text-[13px] text-white/50">ever</span>
        </div>
      </InfoCard>

      <InfoCard>
        <div class="text-white/50 text-[11px] uppercase tracking-[0.08em] mb-2 font-medium">
          Messages tracked
        </div>
        <div class="flex items-baseline gap-2.5">
          <span
            class="font-mono text-[48px] font-semibold leading-none tracking-[-0.03em] text-white"
            data-live-stat="message_count"
          >
            —
          </span>
          <span class="font-mono text-[13px] text-white/50">Long Fast</span>
        </div>
      </InfoCard>
    </div>

    {/* Activity strip */}
    <div class="bg-(--neutral-900) border border-white/10 rounded-md overflow-hidden">
      <div
        class="flex flex-wrap items-center justify-between gap-2 px-4 py-2.5 bg-white/3 border-b border-white/5 text-white/50 text-[11px] uppercase tracking-[0.08em] font-medium"
      >
        <span>Recently heard routers</span>
        <span class="font-mono normal-case tracking-normal">MeshMonitor observations</span>
      </div>
      <p class="px-4 py-3 text-white/70 text-sm border-b border-white/5">
        These are the latest router observations we’ve received. A node heard here doesn’t establish
        coverage at your location.
      </p>
      <div data-live-recent-activity class="grid md:grid-cols-2 min-h-24 text-white/70 text-sm">
        <p class="px-4 py-3">Loading router observations…</p>
      </div>
    </div>
  </div>
</section>
